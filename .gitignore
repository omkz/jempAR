# ==============================================================================
# Standard Unity .gitignore for Unity 6 (6000.2.14f1)
# ==============================================================================

# Unity generated and local directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/

# Unity crash reports and logs
*.log
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Visual Studio / Rider / IDE generated files and caches
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# Unity generated meta files for debug/temp files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Build artifacts and standalone packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# 3D DCC tools temporary/backup files (Blender, etc.)
*.blend1
*.blend1.meta

# Addressables and auto-generated asset caches
/ServerData/
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/Unity.VisualScripting.Generated/*
/[Aa]ssets/[Ss]ceneDependencyCache*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/UIElementsSchema/

# Plastic SCM local metadata and temporary files
.plastic/
*.private
*.private.meta

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
*~

# ==============================================================================
# Whitelist rules: Ensure source files and essential Unity configs remain tracked
# ==============================================================================
!/[Aa]ssets/
!/[Pp]ackages/
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json
!/[Pp]roject[Ss]ettings/
